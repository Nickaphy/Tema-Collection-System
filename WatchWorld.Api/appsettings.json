{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "Local": "Server=localhost;Database=WatchWorld;Trusted_Connection=True;TrustServerCertificate=True;",
        "DefaultConnection": "Server=sql-server,1433;Database=WatchWorld;User Id=sa;Password=${SA_PASSWORD};TrustServerCertificate=True;"
    },
    
    "JwtSettings": {
        "Issuer": "WatchWorld.Api",
        "Audience": "WatchWorld.BlazorUI",
        "ExpiryMinutes": 60
    }
}