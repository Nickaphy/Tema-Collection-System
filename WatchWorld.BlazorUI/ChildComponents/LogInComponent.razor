@using Radzen
@using Radzen.Blazor
@using WatchWorld.BlazorUI.ResponseDTO

<div class="ww-auth-dialog">
    @if (!string.IsNullOrEmpty(infoMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" class="rz-mb-4">
            @infoMessage
        </RadzenAlert>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-mb-4">
            @errorMessage
        </RadzenAlert>
    }

    <RadzenTemplateForm TItem="LoginModel" Data="@loginModel" Submit="@OnSubmit">
        <div class="rz-mb-3">
            <RadzenFormField Text="E-mail" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@loginModel.Email" Name="Email" />
            </RadzenFormField>
            <RadzenRequiredValidator Component="Email" Text="E-mail er påkrævet" />
            <RadzenEmailValidator Component="Email" Text="Indtast en gyldig e-mailadresse" />
        </div>

        <div class="rz-mb-4">
            <RadzenFormField Text="Adgangskode" Style="width: 100%;">
                <RadzenPassword @bind-Value="@loginModel.Password" Name="Password" />
            </RadzenFormField>
            <RadzenRequiredValidator Component="Password" Text="Adgangskode er påkrævet" />
        </div>

        <div class="rz-d-flex rz-justify-content-end rz-gap-2">
            <RadzenButton ButtonType="ButtonType.Button"
                          Text="Annuller"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@(() => DialogService.Close(false))" />
            <RadzenButton ButtonType="ButtonType.Submit"
                          Text="Log ind"
                          ButtonStyle="ButtonStyle.Primary"
                          IsBusy="@isSubmitting" />
        </div>
    </RadzenTemplateForm>
</div>

@code {
    [Inject] private DialogService DialogService { get; set; } = default!;
    [Inject] private NotificationService NotificationService { get; set; } = default!;
    [Inject] private WatchWorldApiClient ApiClient { get; set; } = default!;

    private LoginModel loginModel = new();
    private bool isSubmitting;
    private string? errorMessage;
    private string? infoMessage;

    private async Task OnSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        var request = new LogInRequestDto
        {
            Email = loginModel.Email,
            Password = loginModel.Password
        };

        var (success, user, error) = await ApiClient.LogInAsync(request, CancellationToken.None);

        isSubmitting = false;

        if (!success)
        {
            errorMessage = error ?? "Log ind mislykkedes. Tjek dine oplysninger og prøv igen.";
            return;
        }

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Velkommen tilbage",
            Detail = $"Du er nu logget ind.",
            Duration = 3000
        });

        DialogService.Close(true);
    }

    public class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
